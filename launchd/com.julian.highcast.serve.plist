<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.julian.highcast.serve</string>
  <key>ProgramArguments</key><array>
    <string>__PROJECT__/.venv/bin/highcast</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__PROJECT__/data/serve.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/serve.err</string>
</dict></plist>
